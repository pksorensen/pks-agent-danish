#!/usr/bin/env python3
"""Launch the project-owned environment without changing the system Python."""
import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root))
from scripts.common import DATA

interpreter = DATA / "venv" / "bin" / "python"
if not interpreter.is_file():
    raise SystemExit("Kør først python3.12 scripts/setup.py fra projektmappen.")
os.execv(str(interpreter), [str(interpreter), str(root / "danish.py"), *sys.argv[1:]])
